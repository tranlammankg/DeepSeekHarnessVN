{
  "name": "@ailamman/dsh-remote-settings",
  "version": "0.1.0",
  "description": "Let a page this deployment already trusts use the full Settings surface (Models, provider directory, API keys) instead of the client's process-local fallback",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "loopback",
    "trusted-host"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/client-check.mjs && node scripts/host-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
